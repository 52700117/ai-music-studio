{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/audio/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|audio/).*)",
      "destination": "/index.html"
    }
  ]
}