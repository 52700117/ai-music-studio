<!DOCTYPE html>
<!--
  Music Studio - Desktop GUI
  ============================================================
  This is an HTA (HTML Application) file.
  Double-click (or run via mshta.exe) opens a NATIVE Win32
  window (NOT a browser tab) — exactly like QQ / WeChat:
    - Has its own window on the taskbar
    - No URL / address bar
    - No back/forward buttons
    - Title bar shows "音乐创作软件"
    - Resizable / minimizable / maximizable
  It reads the actual server port from port.txt and uses
  an iframe to load http://localhost:<port>

  Uses only built-in Windows components: mshta.exe + IE
  rendering engine. Zero extra downloads required.
-->
<HTML>
<HEAD>
  <TITLE>Music Studio</TITLE>
  <HTA:APPLICATION
    ID="MusicStudioApp"
    APPLICATIONNAME="MusicStudio"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    SCROLL="no"
    VERSION="1.0.0"
    INNERBORDER="no"
    CONTEXTMENU="yes"
    NAVIGABLE="yes"
  />
  <meta http-equiv="x-ua-compatible" content="IE=edge" />
  <style type="text/css">
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #FFFFFF;
      font-family: "Microsoft YaHei", "Segoe UI", Tahoma, sans-serif;
      color: #111111;
    }
    #loading {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #FF4D2E 0%, #3B5BA5 100%);
      color: #FFFFFF;
    }
    #loading h1 {
      font-size: 28px;
      font-weight: 600;
      margin: 0 0 12px 0;
      letter-spacing: 1px;
    }
    #loading p {
      font-size: 14px;
      opacity: 0.9;
      margin: 0 0 24px 0;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255,255,255,0.25);
      border-top-color: #FFFFFF;
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
      margin-bottom: 28px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    #app-frame {
      width: 100%;
      height: 100%;
      border: 0;
      display: none;
      margin: 0;
      padding: 0;
    }
    #fallback {
      display: none;
      padding: 32px;
      text-align: center;
    }
    #fallback button {
      padding: 10px 28px;
      background: #FF4D2E;
      color: #FFFFFF;
      border: 0;
      border-radius: 6px;
      font-size: 14px;
      cursor: pointer;
    }
  </style>
  <script language="VBScript">
    ' =====================================================================
    ' Read port.txt from install directory (next to this app.hta file)
    ' Then redirect inner frame to http://127.0.0.1:<port>
    ' =====================================================================
    Option Explicit

    Sub Window_OnLoad
      resizeWindow
      loadApp
    End Sub

    Sub resizeWindow
      Dim scrW, scrH, w, h
      scrW = window.screen.availWidth
      scrH = window.screen.availHeight
      w = 1200
      h = 820
      If w > scrW Then w = scrW
      If h > scrH Then h = scrH
      window.resizeTo w, h
      window.moveTo (scrW - w) \ 2, (scrH - h) \ 2
    End Sub

    Function ReadPort
      Dim fso, appDir, portFile, txt, p
      ReadPort = 3001  ' default fallback

      On Error Resume Next
      Set fso = CreateObject("Scripting.FileSystemObject")
      ' Get the directory where this app.hta lives
      appDir = fso.GetParentFolderName(location.pathname)
      portFile = fso.BuildPath(appDir, "port.txt")
      If fso.FileExists(portFile) Then
        txt = Trim(fso.OpenTextFile(portFile, 1).ReadAll())
        If IsNumeric(txt) Then
          p = CInt(txt)
          If p > 0 And p < 65536 Then ReadPort = p
        End If
      End If
    End Function

    Sub loadApp
      Dim port, url
      port = ReadPort()
      url = "http://127.0.0.1:" & port & "/"
      document.getElementById("portLabel").innerText = url
      ' Start with iframe hidden; show loading screen
      ' Use setTimeout so UI paints before blocking
      setTimeout "ShowLoadingThenNavigate """ & url & """", 100
    End Sub

    Sub ShowLoadingThenNavigate(url)
      Dim frame
      Set frame = document.getElementById("app-frame")
      frame.src = url
      ' Hide loading after iframe loaded (give server 3s minimum + poll)
      Dim pollCount, maxPolls
      pollCount = 0
      maxPolls = 120  ' ~60 seconds
      Dim timerId
      timerId = window.setInterval(GetRef("PollIframe"), 500, Null)
      ' Store interval ID via global scoped variable
      window.SetIntervalId = timerId
    End Sub

    Dim pollCount
    pollCount = 0

    Sub PollIframe
      On Error Resume Next
      pollCount = pollCount + 1
      If pollCount > 120 Then
        window.clearInterval window.SetIntervalId
        ShowFallback
        Exit Sub
      End If
      ' Just swap loading -> frame after ~2s (HTA cross origin blocks
      ' readystate from iframe, but server is local so it's quick)
      If pollCount = 4 Then
        document.getElementById("loading").style.display = "none"
        document.getElementById("app-frame").style.display = "block"
      End If
    End Sub

    Sub ShowFallback
      document.getElementById("loading").style.display = "none"
      document.getElementById("app-frame").style.display = "none"
      document.getElementById("fallback").style.display = "block"
    End Sub

    Sub OpenInBrowser
      Dim port, url, sh
      port = ReadPort()
      url = "http://127.0.0.1:" & port & "/"
      Set sh = CreateObject("WScript.Shell")
      sh.Run url
    End Sub
  </script>
</HEAD>
<BODY>
  <div id="loading">
    <div class="spinner"></div>
    <h1>音乐创作软件</h1>
    <p>正在启动，很快就能开始创作了…</p>
    <p style="font-size:12px;opacity:0.7;">
      加载地址：<span id="portLabel">http://127.0.0.1:3001/</span>
    </p>
  </div>

  <div id="fallback">
    <h2>启动时间较长，请重试</h2>
    <p>如果软件窗口一直停留在加载页面，请点击下方按钮使用浏览器打开：</p>
    <br />
    <button onclick="OpenInBrowser()">在浏览器中打开</button>
  </div>

  <iframe
    id="app-frame"
    APPLICATION="yes"
    src="about:blank"
    marginwidth="0"
    marginheight="0"
    frameborder="0"
  ></iframe>
</BODY>
</HTML>
