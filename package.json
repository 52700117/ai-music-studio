{
  "name": "workspace",
  "private": true,
  "version": "1.0.0",
  "description": "音乐创作软件 - 前后端一体",
  "author": "music-app",
  "type": "module",
  "bin": {
    "music-app": "./start.js"
  },
  "main": "./start.js",
  "pkg": {
    "scripts": [
      "start.js",
      "server/**/*.ts",
      "server/**/*.js"
    ],
    "assets": [
      "dist/**/*",
      "public/**/*",
      "server/migrations/**/*",
      "package.json"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "release"
  },
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "vercel-build": "vite build",
    "railway-build": "vite build",
    "cloudbase-build": "npm ci --omit=dev --no-audit --no-fund && npx tsc -b && npx vite build && node scripts/cloudbase-pack.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "start": "tsx server/server.ts",
    "start:prod": "node dist-server/server.js",
    "cap": "cap",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:open": "cap open android",
    "mobile:android:build": "npm run mobile:sync && cap build android --keystorepath ./keystore.jks --keystorepass android --keystorealias androiddebugkey --keystorealiaspass android",
    "mobile:ios:open": "cap open ios",
    "mobile:ios:build": "npm run mobile:sync && cap build ios"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.20.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@eslint/js": "^9.25.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
